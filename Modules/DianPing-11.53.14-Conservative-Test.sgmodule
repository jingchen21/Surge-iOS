#!name=大众点评 11.53.14（保守测试）
#!desc=基于公开规则整理的保守测试版。11.53.14 尚未得到脚本作者确认支持；优先保留首页、签到、榜单和新品等功能。
#!author=ChatGPT（基于公开规则整理）
#!tag=去广告,兼容性测试
#!surge_version=5.14.2(Build3405,SDK18.2)

[Rule]
# 已知广告/统计域名
DOMAIN, r.dianping.com, REJECT
DOMAIN, tte.meituan.com, REJECT
DOMAIN, lx0.meituan.com, REJECT
DOMAIN, dxlvs.meituan.com, REJECT
DOMAIN, dpmtpush.dianping.com, REJECT
DOMAIN, dynamicf.sankuai.com, REJECT
DOMAIN, live-monitor-broker.sankuai.com, REJECT
DOMAIN-SUFFIX, lx.meituan.net, REJECT
IP-CIDR, 101.32.16.204/32, REJECT, no-resolve
IP-CIDR, 103.63.160.80/32, REJECT, no-resolve
IP-CIDR, 119.29.126.137/32, REJECT, no-resolve

[URL Rewrite]
# 明确的开屏/广告接口
^https?:\/\/103\.37\.155\.60\/fetch - reject
^https?:\/\/catdot\.dianping\.com\/broker-service\/hijack - reject
^https?:\/\/mapi\.dianping\.com\/mapi\/operating\/loadsplashconfig - reject
^https?:\/\/mapi\.dianping\.com\/adshopping - reject

[Map Local]
# 广告查询接口返回空 JSON，尽量避免直接拒绝产生异常
^https?:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/queryWechatAdvertisement data-type=json data="{}" status-code=200

[Script]
# 仅处理大众点评常见广告图片与广告卡片资源；当前版本兼容性仍需实测
DianPingImage = type=http-response,pattern=^https?:\/\/img\.meituan\.net\/(?>dpmobile|goodsawardpic)\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/dianping.js
DianPingCard = type=http-response,pattern=^https?:\/\/ddplus\.meituan\.net\/v\d\/mss_\w+\/picassovc,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/dianping.js

[MITM]
hostname = %APPEND% 103.37.155.60, catdot.dianping.com, mapi.dianping.com, img.meituan.net, rms.meituan.com, ddplus.meituan.net
