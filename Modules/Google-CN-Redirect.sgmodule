#!name=Google CN Redirect
#!desc=Redirect Google China domains to their international equivalents. A local MITM CA is required. This is already included in the main profile; use only one.

[URL Rewrite]
^https?:\/\/(?:ditu|maps)\.google\.cn(.*)$ https://maps.google.com$1 302
^https?:\/\/(?:www\.)?(?:g|google)\.cn(.*)$ https://www.google.com$1 302

[MITM]
hostname = %APPEND% google.cn, *.google.cn, g.cn, *.g.cn
