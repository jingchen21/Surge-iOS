#!name=中国移动去广告
#!desc=页面净化（ccyykk666）+ 开屏直拒（含 jiguang / 弹窗接口）。含 AES 垫片与开关。
#!author=ccyykk666
#!arguments=HideTopFamily:false,HideTopAge:false,HideTopPhone:false,HideTopNearby:false,HideTopAI:false,HideTopEnterprise:false,BottomClean:true,MineClean:true

# 来源：https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/china-mobile/china_mobile_ad.plugin
# 脚本：https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js
# 更新时间：2026-10-27
# 开屏：startInit/getAdverList 用 reject-dict；CDN 素材 reject-200（避免白屏壳）
# 个人使用快照：同步自 https://github.com/muktsoen/SurgeRules （ChinaMobile.sgmodule）
# 关联 JS 已改指向本仓库 Raw；原作者署名与 Loon 来源注释保留。

[Script]
CM-homepage = type=http-response,pattern=^https://client\.app\.coc\.10086\.cn/biz-orange/(?:DN/(?:homePage/getTopAreaList|multipleInterfaces/aggregationData|searchWord/getSearchWordInfo)|DA/baseServiceFunction/getAdverList)(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-navigation = type=http-response,pattern=^https://client\.app\.coc\.10086\.cn/biz-orange/DN/init/getNavigation(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-bottomnav = type=http-response,pattern=^https://client\.app\.coc\.10086\.cn/biz-orange/DN/bottomNavigationService/getNavigationInfo(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-mypage = type=http-response,pattern=^https://client\.app\.coc\.10086\.cn/biz-orange/DN/myPageNew/getMyPageNew(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-h5 = type=http-response,pattern=^https://(?:h\.app\.coc\.10086\.cn/biz-orange/DH/(?:message_query/message/query/list|myCardVoucher/getBannerList)|app\.10086\.cn/biz-orange/DA/commonBoard/getCommonBoard)(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-recharge = type=http-response,pattern=^https://touch\.10086\.cn/i/v1/cust/(?:aiMainQry|iopBatchQry)/[^?]+(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-popwindow = type=http-response,pattern=^https://touch\.10086\.cn/i/v1/pay/popWindowQry/[^?]+(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-adfilter = type=http-response,pattern=^https://ad\.mcloud\.139\.com/advertapi/adv-filter/adv-filter/AdInfoFilter/getAdInfos(?:\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile.surge.js,argument=HideTopFamily:{{{HideTopFamily}}};HideTopAge:{{{HideTopAge}}};HideTopPhone:{{{HideTopPhone}}};HideTopNearby:{{{HideTopNearby}}};HideTopAI:{{{HideTopAI}}};HideTopEnterprise:{{{HideTopEnterprise}}};BottomClean:{{{BottomClean}}};MineClean:{{{MineClean}}}
CM-reject = type=http-request,pattern=^https://client\.app\.coc\.10086\.cn/biz-orange/(?:DN/(?:dropsAdverService/getDropsAdverNew|homepagePopup/getSortInfo|toast/getToastRule)|DH/toast/august/getToast|DA/liveSuspension/getPageCode)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile-request.surge.js
CM-splash-init = type=http-request,pattern=^https://(client\.app\.coc\.10086\.cn|clientaccess\.10086\.cn)/biz-orange/DN/(init/startInit|explorePage/getAdverList),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/ChinaMobile-request.surge.js
# ===== 开屏补充（上游 Loon 未覆盖） =====
# 白屏+跳过按钮：素材被拦但开屏接口仍下发壳；接口用 reject-dict，素材用 reject-200。

[Rule]
# 开屏/埋点相关直拒（用户日志出现 jiguang.coc.10086.cn；参考 TomCatXue ChinaMobile）
DOMAIN-SUFFIX,jiguang.coc.10086.cn,REJECT
DOMAIN,apm.clientaccess.10086.cn,REJECT
DOMAIN-SUFFIX,cmicapm.com,REJECT
DOMAIN,ad.mcloud.139.com,REJECT
DOMAIN-SUFFIX,yxfk.market.chinamobile.com,REJECT

[URL Rewrite]
^https://client\.app\.coc\.10086\.cn/biz-orange/DN/init/startInit - reject-dict
^https://client\.app\.coc\.10086\.cn/biz-orange/DN/explorePage/getAdverList - reject-dict
^https://clientaccess\.10086\.cn/biz-orange/DN/init/startInit - reject-dict
^https://app\.10086\.cn/biz-orange/DN/(findSale|homeSale)/getsaleAdver - reject-dict
^https://client\.app\.coc\.10086\.cn/biz-orange/DN/explorePage/ - reject-dict
^https://(?:client\.app\.coc|app)\.10086\.cn/biz-orange/(?:DN|DA)/emotionMarket - reject-dict
^https://client\.app\.coc\.10086\.cn/biz-orange/DN/homePage/getPopupInfo - reject-dict
^https://client\.app\.coc\.10086\.cn/biz-orange/DN/detainment/ - reject-dict
^https://client\.app\.coc\.10086\.cn/biz-orange/DH/(?:detainment|facePopup|livePopup)/ - reject-dict
^https://client\.app\.coc\.10086\.cn/biz-orange/DN/dropsAdver - reject-dict
^https://client\.app\.coc\.10086\.cn/biz-orange/DN/homepagePopup/getSortInfo - reject-dict
^https?://res\.app\.coc\.10086\.cn/qwhdcdn_cmcc-cs_cn/prd-mgcenter/ - reject-200
^https?://res\.app\.coc\.10086\.cn/group\d/M00/[0-9]{2}/[A-Z0-9]{2}/.+\.jpg - reject-200
^https?://gd\.10086\.cn/gmccfile/file/image/preloading703/ - reject-200
^https?://wap\.js\.10086\.cn/jsmccClient/cd/market_content/api/v\d/market_content\.page\.query - reject-dict

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, clientaccess.10086.cn, h.app.coc.10086.cn, h.client.app.coc.10086.cn, app.10086.cn, touch.10086.cn, ad.mcloud.139.com, res.app.coc.10086.cn, gd.10086.cn, wap.js.10086.cn
