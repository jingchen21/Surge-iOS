#!name=SF Express - Ad Filter
#!desc=Filters splash ads, home promotional placements, and advertising endpoints with native Surge rules.
#!category=Ad Remove
#!tag=Ad Blocking, SF Express
#!basedOn=iOS
#!openUrl=https://apps.apple.com/app/id899529698
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31

# No external JavaScript is required. Requires a trusted MITM certificate and native body rewriting.
# Does not intercept app updates, shipping, tracking, points shopping, or membership functions.

[Body Rewrite]
# Remove the selected homepage promotional position while retaining other response fields.
# Disable the next rule if a required homepage section disappears.
http-response-jq ^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appHomeConfig\/query(?:\?.*)?$ 'if (.obj | type) == "array" then .obj |= map(select(.position != 2)) else . end'

[Map Local]
# Return an empty JSON response for dedicated ad endpoints to avoid retries.
^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Suppress promotional recommendation and video-list responses from the home app.
^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/bms\/queryRecommend(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-video\/video\/app\/video\/labelClusterList(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Intercept only the splash campaign endpoint, not the entire CRM service.
^https?:\/\/shopic\.sf-express\.com\/crm\/mobile\/common\/flashscreen(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Ad feed query endpoint.
^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Campaign ad list for the mini program and embedded web views.
^https?:\/\/mcs-mimp-web\.sf-express\.com\/mcs-mimp\/integralPlanet\/getCxAdvertiseList(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% ccsp-egmas.sf-express.com, shopic.sf-express.com, ucmp.sf-express.com, mcs-mimp-web.sf-express.com
