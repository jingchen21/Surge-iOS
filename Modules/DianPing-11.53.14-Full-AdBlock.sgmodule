#!name=Dianping - Targeted Ad Filtering
#!desc=Filters known splash and ad endpoints while prioritizing merchant pages, reviews, images, search, and transactions. Intended for Surge; version 11.53.14 still needs device testing.
#!openUrl=https://apps.apple.com/app/id351091731
#!bundleId=com.dianping.dpscope
#!author=Personal adaptation (based on zirawell/R-Store and Naisi)
#!tag=Ad Blocking
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/dianping.png
#!date=2026-10-28

# Keep the existing filename to preserve previously installed module URLs.
# Rule reference: https://github.com/zirawell/R-Store
# Additional reference: https://github.com/fmz200/wool_scripts
# Match only known ad paths. Do not block analytics/push hosts, shared IPs, page configuration, or ordinary images.
# bundleId is display metadata only; Surge request rules are not isolated by app.
# This module has not been tested on Dianping 11.53.14 on a real device. Inspect recent requests if issues occur.

[URL Rewrite]
# Splash configuration
^https?:\/\/mapi\.dianping\.com\/mapi\/operating\/loadsplashconfig - reject
# Ad-shopping endpoint
^https?:\/\/mapi\.dianping\.com\/adshopping - reject

[MITM]
hostname = %APPEND% mapi.dianping.com
