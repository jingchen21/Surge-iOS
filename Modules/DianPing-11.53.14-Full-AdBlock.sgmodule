#!name=大众点评 - 精准去广告
#!desc=保留明确的开屏和广告接口过滤，优先保证商家、评价、图片、搜索及交易正常；Surge 适用，11.53.14 待真机验证。
#!openUrl=https://apps.apple.com/app/id351091731
#!bundleId=com.dianping.dpscope
#!author=个人自用整理（参考 zirawell / R-Store、奶思）
#!tag=去广告
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/dianping.png
#!date=2026-10-28

# 保留原文件名以兼容已安装的模块地址。
# 规则参考：https://github.com/zirawell/R-Store
# 其他参考：https://github.com/fmz200/wool_scripts
# 只匹配明确广告路径；不屏蔽统计/推送域名、共用 IP、页面配置和普通图片。
# bundleId 仅为模块展示信息，Surge 的请求规则不按 App 隔离。
# 此模块尚未在大众点评 11.53.14 上真机验证；出现异常请检查最近请求。

[URL Rewrite]
# 开屏配置
^https?:\/\/mapi\.dianping\.com\/mapi\/operating\/loadsplashconfig - reject
# 广告购物接口
^https?:\/\/mapi\.dianping\.com\/adshopping - reject

[MITM]
hostname = %APPEND% mapi.dianping.com
