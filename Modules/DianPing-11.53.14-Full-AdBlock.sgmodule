#!name=大众点评 - 全量去广告
#!desc=整合 R-Store 与奶思公开规则，覆盖广告域名、开屏、运营推广、广告图片及部分推广组件。适用于 Surge；大众点评 11.53.14 尚未获得脚本作者明确兼容确认。
#!openUrl=https://apps.apple.com/app/id351091731
#!bundleId=com.dianping.dpscope
#!author=个人自用整合（参考 zirawell / R-Store、奶思）
#!tag=去广告
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/dianping.png
#!date=2026-10-28

# 规则参考：
# - zirawell / R-Store：大众点评 Surge、Quantumult X 规则及 dianping.js
#   https://github.com/zirawell/R-Store
# - 奶思 / fmz200 wool_scripts：大众点评 Loon 插件
#   https://github.com/fmz200/wool_scripts
# 说明：脚本上游说明其适用版本为 11.28.3 及以下；11.53.14 的脚本过滤效果仍需实测。
# 本模块按完整规则整合，不采用保守白名单。若出现功能异常，请通过 Surge 请求日志定位具体规则。

[Rule]
# 大众点评、美团相关广告及统计域名
DOMAIN, r.dianping.com, REJECT
DOMAIN, tte.meituan.com, REJECT
DOMAIN, lx0.meituan.com, REJECT
DOMAIN, dxlvs.meituan.com, REJECT
DOMAIN, dpmtpush.dianping.com, REJECT
DOMAIN, dynamicf.sankuai.com, REJECT
DOMAIN, live-monitor-broker.sankuai.com, REJECT
DOMAIN-SUFFIX, lx.meituan.net, REJECT
IP-CIDR, 101.32.16.204/32, REJECT, no-resolve
IP-CIDR, 103.63.160.80/32, REJECT, no-resolve
IP-CIDR, 119.29.126.137/32, REJECT, no-resolve

[URL Rewrite]
# 开屏、运营推广及广告组件
^https?:\/\/103\.37\.155\.60\/fetch - reject
^https?:\/\/catdot\.dianping\.com\/broker-service\/hijack - reject
^https?:\/\/mapi\.dianping\.com\/mapi\/operating\/(?>indexopsmodules|loadsplashconfig) - reject
^https?:\/\/mapi\.dianping\.com\/wdrpreload\/userprediction - reject
^https?:\/\/mapi\.dianping\.com\/adshopping - reject
^https?:\/\/p\.meituan\.com\/api\/privacy\/config - reject
^https?:\/\/www\.dpfile\.com\/app\/fecommonservice-lottie\/ugc-write-done\/media - reject
^https?:\/\/www\.dpfile\.com\/picasso\/picasso-qa\/src\/AnswerList\/AnswerList-bundle - reject
^https?:\/\/www\.dpfile\.com\/sc\/indexpromotion - reject
^https?:\/\/catfront\.dianping\.com\/api\/metric\?v=\d&p=rn_gcbu_mrn-joy-poidetail - reject
^https?:\/\/awp-assets\.meituan\.net\/hfe\/fep\/\w+\.json - reject
^https?:\/\/s3plus\.meituan\.net\/ocean-blk-index\/index\/blk_conf - reject
^https?:\/\/ddplus\.meituan\.net\/v\d\/mss_\w+\/(?>ehc|titansx|ddblue|edfu)\/ - reject

[Map Local]
# 智能推荐/运营索引接口：按公开规则返回空 JSON
^https?:\/\/mapi\.dianping\.com\/mapi\/intelliindex data-type=json data="{}" status-code=200
# 微信广告查询接口
^https?:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/queryWechatAdvertisement data-type=json data="{}" status-code=200
# 部分广告 GIF 资源替换为空白 GIF
^https?:\/\/p\d\.meituan\.net\/nrpresourcevenus\/\w+\.gif data-type=tiny-gif status-code=200
^https?:\/\/p\d\.meituan\.net\/travelcube\/(?!c129a661)\w+\.gif data-type=tiny-gif status-code=200

[Script]
# 图片广告与 Picasso 广告卡片处理。脚本来自上游公开项目，未复制或修改其源代码。
DianPingImage = type=http-response,pattern=^https?:\/\/img\.meituan\.net\/(?>dpmobile|goodsawardpic)\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/dianping.js
DianPingPicasso = type=http-response,pattern=^https?:\/\/ddplus\.meituan\.net\/v\d\/mss_\w+\/picassovc,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/dianping.js

[MITM]
hostname = %APPEND% 103.37.155.60, *.dianping.com, img.meituan.net, p.meituan.com, rms.meituan.com, www.dpfile.com, awp-assets.meituan.net, s3plus.meituan.net, p*.meituan.net, ddplus.meituan.net
