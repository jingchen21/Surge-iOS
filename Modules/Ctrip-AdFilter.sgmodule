#!name=携程旅行｜温和去广告
#!desc=面向携程 iOS 8.87.4 的谨慎规则。仅过滤已知广告请求，优先降低对主业务接口的影响。
#!author=个人自用整理（AI 辅助编辑）
#!category=去广告
#!date=2026-10-28

# SPDX-License-Identifier: GPL-3.0-only
# 个人自用；本文件经 AI 辅助整理与兼容性筛选，非携程官方模块，也不代表原作者背书。
# 规则参考与感谢：奶思及 fmz200/wool_scripts 维护者公开分享的携程 Surge 模块。
# 来源：https://github.com/fmz200/wool_scripts/blob/main/Surge/module/split/partX/Ctrip.sgmodule
# 本文件仅保留低风险的已知广告请求规则，并非原作者发布的版本。
# 不启用 tripAds：公开规则提示，携程 8.47.0 及以上版本可能因此出现部分图片加载异常。
# 不启用 getTimeZoneServerIpList：该规则与旧版本降级/更新提示有关，不作为当前版本的默认去广告规则。
# 仅供个人自用。若公开分发衍生版本，需保留来源与修改说明，并遵守 GPL-3.0 及其他适用条款。

[URL Rewrite]
# 携程广告相关请求：只拦截已知广告路径，不拦截携程主 API。
^https?:\/\/ma-adx\.ctrip\.com\/_ma\.gif - reject

# 百度落地分享页广告。该规则需要对 mbd.baidu.com 启用 MITM。
^https?:\/\/mbd\.baidu\.com\/newspage\/api\/getmobads\?page\=landingshare - reject

[MITM]
hostname = %APPEND% ma-adx.ctrip.com, mbd.baidu.com
