#!name=携程净化
#!desc=拦截携程已知开屏广告及指定第三方广告接口；默认不对携程核心业务域名启用 MITM。
#!category=广告过滤
#!openUrl=https://apps.apple.com/app/id379395415
#!date=2026-10-28

[Rule]
# 携程开屏广告资源
DOMAIN,ma-adx.ctrip.com,REJECT

# 指定广告服务
DOMAIN,sofire.baidu.com,REJECT

[URL Rewrite]
# 仅拦截百度广告接口，不拦截百度其他业务
^https?:\/\/mbd\.baidu\.com\/newspage\/api\/getmobads(?:\?.*)?$ - reject

[MITM]
hostname = %APPEND% mbd.baidu.com
