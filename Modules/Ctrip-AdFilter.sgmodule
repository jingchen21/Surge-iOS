#!name=携程旅行｜开屏去广告增强测试版
#!desc=针对携程 iOS 8.87.4 的开屏广告补充拦截：精准处理 tripAds，并保留原有广告请求过滤；可能导致图片或业务页面异常，请单独测试。
#!author=个人自用整理（AI 辅助编辑）
#!category=去广告
#!openUrl=https://apps.apple.com/app/id379395415
#!date=2026-10-28

# SPDX-License-Identifier: GPL-3.0-only
# 个人自用；不是携程官方模块，尚未在携程 8.87.4 上完成真机验证。
# 本次基于自用版本补充携程 tripAds 规则，以提升开屏广告拦截覆盖面。
# 参考来源及原始版权：fmz200/wool_scripts（奶思）公开的携程 Surge 模块。
# https://github.com/fmz200/wool_scripts/blob/main/Surge/module/split/partX/Ctrip.sgmodule
# 经 AI 辅助编辑；本文件是修改后的实验性版本，不是上游原版。
# 保留此来源与许可记录；后续公开分发时遵循 GPL-3.0 适用条款。
# 风险：公开规则提示携程 8.47.0 以上版本阻断 tripAds 后可能出现部分图片加载异常。
# 若出现酒店图片缺失、搜索异常、下单异常或 MITM 报错，立即停用本模块。
# 启用前请关闭其他携程广告过滤模块；不要同时启用温和版与增强版。

[Rule]
# 该域名与携程广告请求有关；直接拒绝，避免仅拦截统计 GIF 而漏掉其他请求。
DOMAIN,ma-adx.ctrip.com,REJECT

[URL Rewrite]
# 保留原有的百度分享落地页广告过滤。
^https?:\/\/mbd\.baidu\.com\/newspage\/api\/getmobads\?page=landingshare(?:&|$) - reject

[Map Local]
# 开屏广告核心测试项：覆盖 json/scjson 与不带前缀的 tripAds 端点。
# 不拦截携程所有 restapi，不处理订单、酒店、机票及登录相关接口。
^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/[0-9]{4,6}\/(?:(?:json|scjson)\/)?tripAds(?:\.json)?(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
# 仅对上述 HTTPS 路径解密，应用如使用证书绑定可能拒绝 MITM。
hostname = %APPEND% m.ctrip.com, mbd.baidu.com
