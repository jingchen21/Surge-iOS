#!name=Coolapk - Ad Filter
#!desc=Filters sponsored cards and explicitly marked promotions without removing regular posts.
#!category=Ad Remove
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31

[Script]
Coolapk-Home = type=http-response, pattern=^https:\/\/api\.coolapk\.com\/v\d+\/main\/(?:dataList|indexV\d*|init)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/Coolapk.js, requires-body=true, timeout=30
Coolapk-Sections = type=http-response, pattern=^https:\/\/api\.coolapk\.com\/v\d+\/page\/dataList(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/Coolapk.js, requires-body=true, timeout=30
Coolapk-Feed-Replies = type=http-response, pattern=^https:\/\/api\.coolapk\.com\/v\d+\/feed\/(?:detail|replyList)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/Coolapk.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% api.coolapk.com
