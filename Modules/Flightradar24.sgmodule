#!name=Flightradar24 Gold Unlock
#!desc=Replaces the Flightradar24 mobile user-session response with a Gold subscription payload for testing.
#!category=Hack VIP

[Script]
Flightradar24 Gold = type=http-response,pattern=^https?:\\/\\/mobile\\.flightradar24\\.com\\/mobile\\/(user-session|\\w{9}),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/Flightradar24.surge.js,timeout=10

[MITM]
hostname = %APPEND% mobile.flightradar24.com
