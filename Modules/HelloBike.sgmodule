#!name=HelloBike - Surge Port
#!desc=Quantumult X ad blocking, Home/Me page cleanup, and AES/dynamic-key handling. Requires easybike.surge.js; locally ported and not verified against the live app.
#!author=ZenmoFeiShi (original); Surge compatibility port
#!version=2026-10-24

# Personal-use snapshot: user-provided HelloBike Quantumult X-to-Surge port (original author: ZenmoFeiShi)
# Script: https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/easybike.surge.js
# Updated: 2026-10-28
# Note: locally converted and not verified against the live app; original attribution is retained.

[Map Local]
# QX reject-200 -> Surge 200 with empty text body.
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) data-type=text data="" status-code=200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) data-type=text data="" status-code=200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) data-type=text data="" status-code=200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) data-type=text data="" status-code=200

[Script]
# Original QX script-echo-response: http-request local mock, not http-response.
HelloBike-UI-Template = type=http-request, pattern=^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json\?(?:[^#]*&)?md5=e5230c919f7e3f3af3256161fbfaa0e2&(?:[^#]*&)?hbe_qx_ui=1\.3$, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/easybike.surge.js, requires-body=false, timeout=20, engine=webview
HelloBike-Key = type=http-response, pattern=^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/easybike.surge.js, requires-body=true, max-size=131072, timeout=20, engine=webview
HelloBike-API-Request = type=http-request, pattern=^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/easybike.surge.js, requires-body=true, max-size=1048576, timeout=20, engine=webview
HelloBike-API-Response = type=http-response, pattern=^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/easybike.surge.js, requires-body=true, max-size=4194304, timeout=20, engine=webview

[MITM]
hostname = %APPEND% api.hellobike.com, marketingapi.hellobike.com, entertainment.hellobike.com, api-htp.beizi.biz, adservice.sigmob.cn, tm.sigmob.cn, mi.gdt.qq.com, v2mi.gdt.qq.com, resource.51downapp.cn
