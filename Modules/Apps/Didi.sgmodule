#!name=滴滴出行净化
#!desc=个人中心、导航、推荐及钱包页面精简；原生 jq/Map Local，无 JS 依赖。
#!author=怎么肥事
# Original rules: https://github.com/ZenmoFeiShi/Qx/blob/3e442e78e95be2c71153e55560a977ea42495f27/Didichuxing.snippet
# Requires Surge iOS 5.14.0+ / Mac 5.9.0+ for native jq.

[Rule]
DOMAIN,gwp.xiaojukeji.com,REJECT
IP-CIDR,139.199.244.6/32,REJECT,no-resolve
IP-CIDR,113.46.225.9/32,REJECT,no-resolve
IP-CIDR,139.199.244.7/32,REJECT,no-resolve
IP-CIDR,113.46.225.8/32,REJECT,no-resolve
IP-CIDR,123.207.209.39/32,REJECT,no-resolve
IP-CIDR,123.207.209.60/32,REJECT,no-resolve
IP-CIDR,139.199.240.15/32,REJECT,no-resolve
IP-CIDR,139.199.240.12/32,REJECT,no-resolve
IP-CIDR,116.85.3.37/32,REJECT,no-resolve
IP-CIDR,162.14.157.2/32,REJECT,no-resolve
IP-CIDR,162.14.157.24/32,REJECT,no-resolve
IP-CIDR,116.85.1.0/32,REJECT,no-resolve
IP-CIDR,116.85.1.17/32,REJECT,no-resolve
IP-CIDR,116.85.1.22/32,REJECT,no-resolve
IP-CIDR,116.85.3.25/32,REJECT,no-resolve

[Body Rewrite]
http-response-jq ^https://common\.diditaxi\.com\.cn/common/v[5-9]/usercenter/layout '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data.layout.order |= map(select(. == "center_base_info_card" or . == "center_order_related_card" or . == "center_wallet_finance_card")) | (.data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == "优惠卡券"))) | del(.data.instances.center_marketing_card, .data.instances.center_member_card, .data.instances.center_tool_card, .data.instances.center_widget_list)) else . end) catch $original'
http-response-jq ^https://common\.diditaxi\.com\.cn/common/v\d/usercenter/me '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data.cards |= (map(select(.title != "天天领福利" and .title != "金融服务" and .title != "更多服务" and .title != "企业服务" and .title != "安全中心")) | map(if .tag == "wallet" then (.items |= map(select(.title == "优惠券"))) | (if .card_type == 4 then .bottom_items |= map(select(.title == "省钱套餐" or .title == "出行里程")) else . end) else . end))) else . end) catch $original'
http-response-jq ^https://conf\.diditaxi\.com\.cn/homepage/v\d/core '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data.order_cards.nav_list_card.data |= map(select(.nav_id == "dache_anycar" or .nav_id == "driverservice" or .nav_id == "bike" or .nav_id == "carmate" or .nav_id == "nav_more_v3")) | .data.disorder_cards.bottom_nav_list.data |= map(select(.id == "v6x_home" or .id == "home_page" or .id == "user_center")) | .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select(.name != "旅行" and .name != "车主"))) else . end) catch $original'
http-response-jq ^https://api\.udache\.com/gulfstream/pre-sale/v1/other/pGetSceneList '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data.scene_list |= map(select(.text != "优惠商城")) | .data.show_data |= map(.scene_ids |= map(select(. != "scene_coupon_mall")))) else . end) catch $original'
http-response-jq ^https://conf\.diditaxi\.com\.cn/homepage/v1/oversea/layout '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (del(.data.instances.oversea_main_banner)) else . end) catch $original'
http-response-jq ^https://api\.udache\.com/gulfstream/porsche/v1/dache_homepage_layout '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (del(.data.instances["xp-card-01"])) else . end) catch $original'
http-response-jq ^https://api\.udache\.com/gulfstream/passenger-center/v2/other/pInTripLayout '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (del(.data.order_components[8].data) | .data.order_components |= map(select(.name != "passenger_common_casper"))) else . end) catch $original'
http-response-jq ^https://mapi\.xiaojukeji\.com/passenger-wallet/api/v[\d.]+/wallet/homepage '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data.cardList |= (map(if .mcode == "index_assets_v6" then .detailData |= (del(.myCreditLimit) | .discountList |= .[:3] | del(.noticeList)) else . end) | map(select(.mcode == "index_assets_v6")))) else . end) catch $original'
http-response-jq ^https://manhattan\.webapp\.xiaojukeji\.com/zootopia/api/my-assets/get-assets-data '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (del(.data.myQuotaModularRes, .data.assetsData.myQuotaModularRes, .data.banner, .data.assetsData.banner, .data.myGuaranteeModularRes, .data.assetsData.myGuaranteeModularRes)) else . end) catch $original'
http-response-jq ^https://manhattan\.webapp\.xiaojukeji\.com/zootopia/api/my-assets/module-is-show '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data = []) else . end) catch $original'
http-response-jq ^https://ddpay\.xiaojukeji\.com/ddpay/api/manhattan-small-change/get-all-config '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data.result = []) else . end) catch $original'
http-response-jq ^https://ddpay\.xiaojukeji\.com/ddpay/api/manhattan-small-change/get-apollo-config '. as $original | try (if (type == "object" and ((.data | type) == "object" or (.data | type) == "array")) then (.data.result.hideList = []) else . end) catch $original'

[Map Local]
^https://res\.xiaojukeji\.com/resapi/activity/getMulti\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://res\.xiaojukeji\.com/resapi/activity/xpget data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://ct\.xiaojukeji\.com/agent/v3/feeds data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://freight\.xiaojukeji\.com/gateway data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://daijia\.kuaidadi\.com:443/gateway data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://res\.xiaojukeji\.com/resapi/activity/mget data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/slow data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://conf\.diditaxi\.com\.cn/dynamic/conf data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://api\.udache\.com/gulfstream/watson/v1/bubble/getBubble data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://res\.xiaojukeji\.com/resapi/activity/getInsActivityV2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://conf\.diditaxi\.com\.cn/ota/na/yuantu/infoList data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% 117.51.168.*, 113.46.225.*, common.diditaxi.com.cn, freight.xiaojukeji.com, daijia.kuaidadi.com, 162.14.157.*, ct.xiaojukeji.com, res.xiaojukeji.com, conf.diditaxi.com.cn, api.udache.com, 123.207.209.*, 112.53.55.225, 120.241.142.*, 120.241.143.*, 116.85.*, 139.199.240.84, mapi.xiaojukeji.com, manhattan.webapp.xiaojukeji.com, ddpay.xiaojukeji.com
