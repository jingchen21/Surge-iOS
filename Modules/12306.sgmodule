#!name=12306 - Splash and Home Promotions
#!desc=Filters splash ad resources, home information promotions and selected member marketing calls.
#!category=Ad Remove
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[Rule]
DOMAIN,ad.12306.cn,DIRECT

[Script]
12306-Splash-and-MGW = type=http-request,pattern=^https?:\/\/(?:ad\.12306\.cn\/ad\/ser\/getAdList|mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm)(?:\?|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/12306.js,requires-body=false,timeout=15

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn
