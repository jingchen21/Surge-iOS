#!name=浦大喜奔开屏尺寸拦截
#!desc=精确匹配图片素材尺寸；默认保留原样本 1125×1931，18 Pro 实际素材尺寸需看日志确认。
#!arguments=width:1125,height:1931,log:1
#!arguments-desc=width/height 是广告图片的实际像素尺寸，不是手机屏幕尺寸；log=1 记录尺寸，0 关闭日志。
# Source: user-supplied pdxb.js; author and public URL not supplied.
# Surge uses abort:true to stop a response and max-size=-1 for unlimited buffering.

[Script]
SPDB-Splash = type=http-response, pattern=^https?://images?\.spdbccc\.com\.cn/.+, requires-body=true, binary-body-mode=true, max-size=-1, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/pdxb.surge.js, timeout=20, argument="width={{{width}}}&height={{{height}}}&log={{{log}}}"

[MITM]
hostname = %APPEND% image.spdbccc.com.cn, images.spdbccc.com.cn
