#!name=Umetrip - Ad Filter
#!desc=Filters selected splash, homepage and My-tab promotions. Experimental; device verification pending.
#!category=Ad Remove
#!author=xingjiu29 (original) / Surge adaptation
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-11-04
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/da/75/f6/da75f662-e6f4-20db-777b-a047ca7dd497/AppIcon-0-0-1x_U007emarketing-0-7-0-85-220.png/512x512bb.jpg

# Adapted from: https://github.com/xingjiu29/Umetrip (source commit 773d2eafc12466a2b6976e98a90d8201e5351116).
# Response script is self-hosted and pinned to a fixed commit.
# This module decrypts only the listed hosts (MITM) and modifies specific API responses.
# Verify flight search, booking, itinerary, and account functions after enabling.

[Rule]
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,analytics.umetrip.com,REJECT

[URL Rewrite]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native - reject
^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite - reject-dict

[Script]
Umetrip-Response = type=http-response,pattern=(?i)^https?:\/\/(?:bkclient|umerp|home)\.umetrip\.com(?:\.cn)?\/gateway\/api\/umetrip\/native(?:\?.*)?$,requires-body=true,binary-body-mode=true,timeout=30,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/982ce9bf727188c35fc4cd3f797a0157855ae856/Modules/Scripts/Umetrip.js

[MITM]
hostname = %APPEND% umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com
