#!name=Luckin Coffee - Ads and Popups
#!desc=Removes known startup campaigns, app promotional popups and ad-tagged home modules.
#!category=Ad Remove
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/LuckinCoffee.png
#!openUrl=https://apps.apple.com/app/id1296749505
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[URL Rewrite]
^https?:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew(?:\?|$) - reject

[Map Local]
^https?:\/\/(?:capi|ecapi)\.lkcoffee\.com\/resource\/m\/eorder\/product\/popAppTagProductList(?:\?|$) data-type=text data="{\"status\":\"SUCCESS\",\"data\":[]}" status-code=200 header="Content-Type:application/json"

[Script]
Luckin-Promotions = type=http-response,pattern=^https?:\/\/(?:capi|ecapi|m)\.lkcoffee\.com\/(?:capi\/|ecapi\/)?resource\/m\/(?:growUp\/main|member\/exchange\/page|sys\/common\/modules)(?:\?|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/LuckinCoffee.js,requires-body=true,max-size=2097152,timeout=20

[MITM]
hostname = %APPEND% capi.lkcoffee.com, ecapi.lkcoffee.com, m.lkcoffee.com
