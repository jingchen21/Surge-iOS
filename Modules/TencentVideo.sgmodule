#!name=Tencent Video - Cleanup
#!desc=Clean up splash, pre-roll, mid-roll, pause ads, and selected page elements. Binary endpoints use Surge's native body API.
#!category=Ad Remove

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
TencentVideo-0 = type=http-request, pattern=^https?://i\.video\.qq\.com/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/Txvideoad.surge.js, timeout=10
TencentVideo-1 = type=http-response, pattern=^https?://i\.video\.qq\.com/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/Txvideoad.surge.js, timeout=10
TencentVideo-2 = type=http-response, pattern=^https?://iacc\.qq\.com/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/Txvideoad.surge.js, timeout=10
TencentVideo-3 = type=http-response, pattern=^https?://config\.ab\.qq\.com/tab/GetTabRemoteConfig(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/Txvideoad.surge.js, timeout=10
TencentVideo-4 = type=http-response, pattern=^https://rdelivery\.qq\.com/v1/sdkconfig/get(?:\?.*)?$, requires-body=true, binary-body-mode=false, max-size=1048576, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/Txvideoad.surge.js, timeout=10

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
