#!name=Meituan WeChat Mini Program - Cleanup
#!desc=Clean up navigation, promotions, and ads in the Meituan WeChat mini program.
#!category=Ad Remove
# Original rules: https://github.com/ZenmoFeiShi/Qx/blob/3e442e78e95be2c71153e55560a977ea42495f27/WxPureDominion.snippet

[Script]
MeituanMini-0 = type=http-response, pattern=^https://web\.meituan\.com/api/miniprogram/tabbar/all/query, requires-body=true, binary-body-mode=false, max-size=2097152, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/MeituanMiniProgram.surge.js, timeout=10
MeituanMini-1 = type=http-response, pattern=^https://web\.meituan\.com/api/miniprogram/index/aggregate, requires-body=true, binary-body-mode=false, max-size=2097152, script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/JS/MeituanMiniProgram.surge.js, timeout=10

[Map Local]
^https://mapi\.dianping\.com/baymax/adrec/getrecads data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://mapi\.dianping\.com/baymax/getSlotAds data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://web\.meituan\.com/api/miniprogram/my/novelZone data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://web\.meituan\.com/api/miniprogram/my/resources data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://npay\.meituan\.com/conch/flow/mypage-wallet-info data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://web\.meituan\.com/newUser/returnMoney/popWindow data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% web.meituan.com, mapi.dianping.com, npay.meituan.com
