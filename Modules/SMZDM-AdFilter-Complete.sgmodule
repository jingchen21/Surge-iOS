#!name=What Worth Buying (SMZDM) - Comprehensive Ad Filtering
#!desc=Combines verifiable public Loon, Quantumult X, and Surge rules as of 2026-10-28. Covers splash, home, deals, search, encyclopedia, detail, membership, articles, and wallet sections. Aggressive rules may hide non-ad promotions.
#!author=Personal adaptation (AI-assisted)
#!category=Ad Blocking
#!openUrl=https://apps.apple.com/app/id518213356
#!date=2026-10-28

# Personal-use adaptation; not an official SMZDM module.
# Organized and converted into native Surge rules with AI assistance. Each upstream author's attribution and license still apply.
# Sources and acknowledgements:
# - Kelee / ProxyResource: https://github.com/luestr/ProxyResource
#   Reference for home, deals, search, membership, and article rules in Surge/Loon.
# - ZenmoFeiShi: https://github.com/ZenmoFeiShi/Qx
#   Reference for home, deal lists, search, wallet, and promotion-field handling.
# - sooyaaabo：https://github.com/ifflagged/Romeo/tree/main/Modules/Surge/sooyaaabo
#   Reference for search trends, article footers, wallet sections, and third-party ad resources.
# - fmz200：https://github.com/fmz200/wool_scripts
#   Reference for app-update configuration, home-page ad cells, and ad-distribution endpoints.
# - zirawell / R-Store：https://github.com/zirawell/R-Store
#   Reference for multi-page response handling and ad-field filtering.
# - ddgksf2013、blackmatrix7：https://github.com/ddgksf2013/Rewrite ，https://github.com/blackmatrix7/ios_rule_script
#   Cross-check for search, encyclopedia, detail, and membership endpoint clues.
# - ifflagged / Romeo：https://github.com/ifflagged/Romeo
#   Cross-check for consolidated rules across the clients listed above.
# Copyright notice: for personal use and study only; not an official SMZDM module. AI-assisted consolidation retains source authors and links.
# Each source's license and restrictions apply, including CC BY-NC-SA, GPL, and upstream redistribution limits. Do not publish or use commercially until license compatibility has been reviewed.
# If the home page becomes blank, deal lists disappear, search fails, or wallet entries are missing, disable this module first and report the relevant request evidence.

[Rule]
# SMZDM ad-delivery domain
DOMAIN,adx-api.zdmimg.com,REJECT
# Ad analytics endpoint (block this dedicated domain only)
DOMAIN,analytics-api.smzdm.com,REJECT

[URL Rewrite]
# Optional: hide the Wiki/campaign module on deal details. This endpoint may contain normal content, so it is disabled by default.
# ^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/wiki_related_modul(?:\?.*)?$ - reject

[Body Rewrite]
# App startup ad configuration: disable silent-push and Baichuan redirect switches, and remove ad overlays/widgets.
http-response-jq (?i)^https?:\/\/app-api\.smzdm\.com\/util\/update(?:\?.*)?$ 'if (.data | type) == "object" then .data |= (if has("silence_local_push") then .silence_local_push = 0 else . end | if has("baichuan_redirect_switch") then .baichuan_redirect_switch = 0 else . end | del(.ad_black_list, .silence_local_push_msg, .video_cache_num_configs, .haojia_widget, .widget, .operation_float, .operation_float_screen)) else . end'

# Home page: recursively remove known ad cells, ad cards, survey promotions, floating widgets, and theme skins.
http-response-jq (?i)^https?:\/\/homepage-api\.smzdm\.com\/v\d+\/home(?:\?.*)?$ 'def clean: if type == "array" then map(clean) | map(select(. != null)) elif type == "object" then if (.cell_type? == "23008" or .cell_type? == "23005" or .cell_type? == "23024") then null else with_entries(.value |= clean) end else . end; .data |= clean | if (.data.functions | type) == "array" then .data.functions |= map(select(.type == "message")) else . end | if (.data.component | type) == "array" then .data.component |= map(if (.zz_content | type) == "array" then .zz_content |= map(select(((.ad_campaign_id? // "") | tostring | length) == 0 and (.model_type? != "ads") and (.tag? != "广告") and (.article_channel_type? != "questionnaire")) ) else . end) | .data.component |= map(select(.zz_type == "circular_banner" or .zz_type == "fixed_banner" or .zz_type == "filter" or .zz_type == "list")) | .data.component |= map(if (.zz_content | type) == "object" then .zz_content |= del(.circular_banner_option) else . end) else . end | if (.data.services | type) == "array" then .data.services |= map(select(.type == "articel_manage" or .type == "199794" or .type == "199796")) else . end | del(.data.theme, .data.widget, .data.operation_float_screen)'

# Deal list: remove known ad fields/rows, theme skins, and widgets while retaining known normal banner types.
http-response-jq (?i)^https?:\/\/haojia-api\.smzdm\.com\/home\/list(?:\?.*)?$ 'del(.data.header_operation.theme, .data.widget) | if (.data.rows | type) == "array" then .data.rows |= map(select((.cell_type | tostring) == "39001") | select(((has("ad_banner_id") and (.ad_banner_id != null) and (.ad_banner_id != "")) | not) and (.ad? != "ad_campaign_id_") and (.ad? != "ad_campaign_name") and (.ad? != "abs_position") and (.model_type? != "ads") and (.article_tag? != "广告"))) else . end | if (.data.banner_v2 | type) == "array" then .data.banner_v2 |= map(select((.cell_type | tostring) == "21028")) else . end'

# Deal details: remove banners, red-packet assistants, promotion sections, and coupon overlays.
http-response-jq (?i)^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul(?:\?.*)?$ 'del(.data.banner)'
http-response-jq (?i)^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul(?:\?.*)?$ 'del(.data.super_coupon)'
http-response-jq (?i)^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/article_releated_modul(?:\?.*)?$ 'del(.data.lanmu_qikan)'

# Promotion and discount overlay fields on product details.
http-response-jq (?i)^https?:\/\/haojia-api\.smzdm\.com\/detail\/\d+(?:\?.*)?$ 'del(.data.quan_log)'
http-response-jq (?i)^https?:\/\/haojia-cdn\.smzdm\.com\/preload\/\d+\/fiphone\/v\d+_\d+_\d+\/wx\d+\/im\d+\/[0-9a-z]+\/[0-9a-z]+\.json$ 'del(.data.quan_log)'

# Search results: remove ad cards, ad labels, and pinned promotions.
http-response-jq (?i)^https?:\/\/s-api\.smzdm\.com\/sou\/list_v\d+(?:\?.*)?$ 'if (.data.rows | type) == "array" then .data.rows |= map(select(.model_type? != "ads" and .article_tag? != "广告" and .tag? != "广告" and .left_tag? != "广告" and .expose_sct? != "广告" and .promotion_type? != 3)) else . end | if (.data.top_aladdin | type) == "array" then .data.top_aladdin |= map(select(has("ad") | not)) else . end'

# Search discovery, trending lists, red-packet banners, and pop-ups.
http-response-jq (?i)^https?:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags(?:\?.*)?$ 'del(.data.search_faxian, .data.tonglan, .data.hongbao) | if (.data.hot_tab | type) == "array" then .data.hot_tab |= map(select(.search_method != "热点主题榜")) else . end | if (.data.search_hot.home | type) == "array" then .data.search_hot.home |= map(select(.article_tag.article_title != "广告")) else . end'

# Encyclopedia lists: remove entries marked with ad banners.
http-response-jq (?i)^https?:\/\/baike-api\.smzdm\.com\/home_v3\/list(?:\?.*)?$ 'if (.data.rows | type) == "array" then .data.rows |= map(select(((.ad_banner_id? // "") | tostring | length) == 0)) else . end'

# Me / Value Membership: remove campaign entries, banners, and bottom promotion cards.
http-response-jq (?i)^https?:\/\/user-api\.smzdm\.com\/vip(?:\?.*)?$ 'del(.data.activity_entrance_info, .data.big_banner, .data.top_banner, .data.banner_switch, .data.yaoqingshaiwu, .data.right_info)'
http-response-jq (?i)^https?:\/\/user-api\.smzdm\.com\/vip\/bottom_card_list(?:\?.*)?$ 'del(.data.rows)'

# Value Membership benefits banner: remove only items explicitly marked as ads.
http-response-jq (?i)^https?:\/\/zhiyou\.m\.smzdm\.com\/user\/vip\/ajax_get_banner(?:\?.*)?$ 'if (.data.big_banner | type) == "array" then .data.big_banner |= map(select(.logo_title != "广告")) else . end'

# Article bubbles and footer promotions.
http-response-jq (?i)^https?:\/\/article-api\.smzdm\.com\/publish\/get_bubble(?:\?.*)?$ '.data = null'
http-response-jq (?i)^https?:\/\/post\.m\.smzdm\.com\/ajax_app\/ajax_get_footer_list(?:\?.*)?$ 'del(.data.tuiguang_ad, .data.activity_banner)'

# Wallet home: follow the public rule and retain only known core entries; other wallet features may be hidden.
http-response-jq (?i)^https?:\/\/qianbao\.smzdm\.com\/v\d+\/app\/home(?:\?.*)?$ 'if (.data | type) == "array" then .data |= map(select(.id == "40" or .id == "20")) else . end'

# Ad-distribution endpoint: disable is_show_ad when present without changing other fields.
http-response-jq (?i)^https?:\/\/(?:[^/]+\.)?zdmimg\.com\/cpm\/api\/v\d+\/advert_distribution\/get_all_advertise(?:\?.*)?$ 'def disable_ad: if type == "array" then map(disable_ad) elif type == "object" then with_entries(.value |= disable_ad) | if has("is_show_ad") then .is_show_ad = "0" else . end else . end; disable_ad'

[Map Local]
# Splash-loading configuration. Public rules often return empty JSON; if startup or login fails, remove this rule and disable only is_show_ad instead.
(?i)^https?:\/\/app-api\.smzdm\.com\/util\/loading(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Third-party ad-resource index.
(?i)^https?:\/\/s3\.zdmimg\.com\/third\/index(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Detail-page Wiki / 618 campaign module. This endpoint may contain non-ad content; remove this rule if you want to keep the Wiki.
(?i)^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/wiki_related_modul(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Search hot words and search red-packet pop-ups.
(?i)^https?:\/\/s-api\.smzdm\.com\/sou\/search_default_keyword(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?:\/\/s-api\.smzdm\.com\/sou\/popup_coupon(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app-api.smzdm.com, homepage-api.smzdm.com, haojia-api.smzdm.com, haojia.m.smzdm.com, user-api.smzdm.com, article-api.smzdm.com, s-api.smzdm.com, haojia-cdn.smzdm.com, post.m.smzdm.com, qianbao.smzdm.com, s3.zdmimg.com, zdmimg.com, *.zdmimg.com, baike-api.smzdm.com, zhiyou.m.smzdm.com
