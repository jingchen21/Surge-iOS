#!name=PuPu Mall - Marketing Filter
#!desc=Filters marketing banners and hot keywords while retaining checkout and coupons.
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[Script]
PuPu-Marketing = type=http-response,pattern=^https://j1\.pupuapi\.com/client/(?:marketing/(?:banner/v7|banner/search_component_banner|advertisement/v1)|search/hot_keywords/v3)(?:\?|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/PuPuMall.js,requires-body=true

[MITM]
hostname = %APPEND% j1.pupuapi.com
