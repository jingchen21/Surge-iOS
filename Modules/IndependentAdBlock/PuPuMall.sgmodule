#!name=PuPu Mall - Splash and Advertising Filter
#!desc=Filters splash campaigns, banners, sponsored search and selected order advertising.
#!category=Ad Remove
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PuPuMall.png
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[URL Rewrite]
^https?:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100(?:&|$) - reject

[Map Local]
^https?:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/search_input_ranking data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/j1\.pupuapi\.com\/client\/assets\/discount\/order(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/j1\.pupuapi\.com\/client\/marketing\/channel\/global_redeem\/top_tip\/v2(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
PuPu-Ad-Cleanup = type=http-response,pattern=^https?:\/\/j1\.pupuapi\.com\/client\/(?:marketing\/(?:banner\/(?:v\d+|search_component_banner)|advertisement\/v1)|search\/(?:hot_keywords\/v3|hub\/search_box\/products\/v6)|(?:app_)?resource\/resource_preload\/list_h5_resource|order_settlement\/detail|order\/orders\/list\/v4)(?:\?|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/PuPuMall.js,requires-body=true,max-size=2097152,timeout=30

[MITM]
hostname = %APPEND% j1.pupuapi.com
