[Script]
朴朴-广告位置 = type=http-response,pattern=^https://j1\.pupuapi\.com/client/(?:marketing/(?:banner/v7|banner/search_component_banner|advertisement/v1)|search/hot_keywords/v3)(?:\?|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/PuPuMall.js,requires-body=true

[MITM]
hostname = %APPEND% j1.pupuapi.com
