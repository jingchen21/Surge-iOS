#!name=小红书｜独立去广告（保守版）
#!desc=开屏配置、信息流和搜索广告，保留普通笔记、直播与商品
#!author=个人自用整理（AI 辅助），原作者见说明
#!category=去广告
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
# 仅技术参考：zirawell, fmz200, QingRex；全新独立代码，不复制第三方脚本。
# 请遵守原项目许可；未经实机验证，不与其他同类模块同时启用。

[Rule]
DOMAIN,t-ads.xiaohongshu.com,REJECT
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-img-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT

[Script]
XHS-开屏配置 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/(?:config|splash_config)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Xiaohongshu.js, requires-body=true, timeout=30
XHS-营销弹窗 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/surprisebox\/(?:get_style|open|submit_action)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Xiaohongshu.js, requires-body=true, timeout=30
XHS-首页与关注 = type=http-response, pattern=^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v\d+\/(?:homefeed|followfeed)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Xiaohongshu.js, requires-body=true, timeout=30
XHS-搜索推广 = type=http-response, pattern=^https:\/\/(?:edith|so)\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(?:banner_list|notes|hot_list|hint|trending)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Xiaohongshu.js, requires-body=true, timeout=30
XHS-详情推广 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Xiaohongshu.js, requires-body=true, timeout=30
XHS-关注列表 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/user\/followings\/followfeed(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Xiaohongshu.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com
