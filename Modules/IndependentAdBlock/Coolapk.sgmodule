#!name=酷安｜独立去广告（保守版）
#!desc=赞助卡和明确广告标识，保留正常动态、评论和搜索
#!author=个人自用整理（AI 辅助），原作者见说明
#!category=去广告
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
# 仅技术参考：zirawell, fmz200, RuCu6；全新独立代码，不复制第三方脚本。
# 请遵守原项目许可；未经实机验证，不与其他同类模块同时启用。

[Script]
酷安-首页 = type=http-response, pattern=^https:\/\/api\.coolapk\.com\/v\d+\/main\/(?:dataList|indexV\d*|init)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Coolapk.js, requires-body=true, timeout=30
酷安-栏目 = type=http-response, pattern=^https:\/\/api\.coolapk\.com\/v\d+\/page\/dataList(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Coolapk.js, requires-body=true, timeout=30
酷安-动态与评论 = type=http-response, pattern=^https:\/\/api\.coolapk\.com\/v\d+\/feed\/(?:detail|replyList)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Coolapk.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% api.coolapk.com
