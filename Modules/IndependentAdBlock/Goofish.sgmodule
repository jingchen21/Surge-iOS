#!name=Goofish - Ad Filter
#!desc=Filters splash, home, local feed, and search promotions while preserving item listings.
#!category=Ad Remove
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31

[Map Local]
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.live\.home\.ads\.material\.get data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.topic\.banner\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.(?:discover|shade)\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/h5\.m\.goofish\.com\/wow\/moyu\/moyu-project\/idle-xy-seller-home\/pages\/dress-pop(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.home\.welcome(?:\/|\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh(?:\/|\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
[Script]
Goofish-Splash = type=http-response, pattern=^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash(?:\.async)?\.ads(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Goofish.js, requires-body=true, timeout=30
Goofish-Home-Local = type=http-response, pattern=^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.(?:idlehome\.home\.(?:nextfresh|community|newitem\.page)|idle\.local\.home|idle\.home\.whale\.modulet)(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Goofish.js, requires-body=true, timeout=30
Goofish-Search = type=http-response, pattern=^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Goofish.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com, h5.m.goofish.com
