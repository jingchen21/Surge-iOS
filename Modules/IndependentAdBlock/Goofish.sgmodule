#!name=闲鱼｜独立去广告（保守版）
#!desc=开屏、首页、同城与搜索中明确广告条目，不动商品和订单
#!author=个人自用整理（AI 辅助），原作者见说明
#!category=去广告
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
# 仅技术参考：fmz200, zirawell, QingRex；全新独立代码，不复制第三方脚本。
# 请遵守原项目许可；未经实机验证，不与其他同类模块同时启用。

[Script]
闲鱼-开屏 = type=http-response, pattern=^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash(?:\.async)?\.ads(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Goofish.js, requires-body=true, timeout=30
闲鱼-首页与同城 = type=http-response, pattern=^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.(?:idlehome\.home\.(?:nextfresh|community|newitem\.page)|idle\.local\.home|idle\.home\.whale\.modulet)(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Goofish.js, requires-body=true, timeout=30
闲鱼-搜索 = type=http-response, pattern=^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Goofish.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com
