#!name=NetEase Cloud Music - Ad Filter
#!desc=Filters known ad hosts and endpoints; encrypted EAPI responses are untouched.
#!category=Ad Remove
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT

[Map Local]
^https://interface[0-9]?\.music\.163\.com/e?api/(?:ad/|delivery/(?:batch-)?deliver) data-type=json data="{}" status-code=200

[MITM]
hostname = %APPEND% interface.music.163.com, interface1.music.163.com, interface2.music.163.com, interface3.music.163.com
