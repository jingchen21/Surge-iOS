#!name=Baidu Tieba - JSON and Protobuf Ad Filter
#!desc=Filters splash, feed ads, promotional banners, floating elements and selected Protobuf data.
#!category=Ad Remove
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[Rule]
DOMAIN,afd.baidu.com,REJECT
DOMAIN,mobads.baidu.com,REJECT

[Script]
Tieba-JSON-Ads = type=http-response,pattern=^https?:\/\/(?:tiebac|c\.tieba|tieba)\.baidu\.com\/(?:c\/(?:s\/sync|f\/(?:ad\/(?:getSplashAd|getFeedAd)|frs\/(?:page|threadlist|generalTabList)|pb\/(?:picpage|page)|excellent\/personalized|sidebar\/home)|u\/user\/profile)|tiebaads\/commonbatch)(?:\?|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Tieba.js,requires-body=true,timeout=30
Tieba-Protobuf-Ads = type=http-response,pattern=^https?:\/\/(?:tiebac|c\.tieba)\.baidu\.com\/c\/f\/(?:ad\/getFeedAd|frs\/(?:page|threadlist|generalTabList)|pb\/page|excellent\/personalized)\?cmd=,script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/TiebaProto.js,requires-body=true,binary-body-mode=true,max-size=5000000,timeout=30

[MITM]
hostname = %APPEND% tiebac.baidu.com, c.tieba.baidu.com, tieba.baidu.com
