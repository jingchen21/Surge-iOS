#!name=Baidu Tieba - JSON Ad Filter
#!desc=Filters readable JSON ads; binary protobuf responses are not modified.
#!category=Ad Remove
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[Rule]
DOMAIN,afd.baidu.com,REJECT
DOMAIN,mobads.baidu.com,REJECT

[Script]
Tieba-JSON-Ads = type=http-response,pattern=^https?://(?:tiebac|tieba)\.baidu\.com/(?:livefeed/feed|c/(?:f/(?:frs/(?:page|threadlist|generalTabList)|pb/page|sidebar/home)|u/user/profile)|tiebaads/commonbatch)(?:\?|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Tieba.js,requires-body=true

[MITM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
