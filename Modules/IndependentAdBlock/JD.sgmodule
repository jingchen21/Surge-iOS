#!name=JD - Splash and Promotion Filter
#!desc=Filters readable JSON splash and promotions; encrypted client responses are unsupported.
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[Script]
JD-JSON-Ads = type=http-response,pattern=^https://api\.m\.jd\.com/client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|startup|welcomeHome)(?:&|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/JD.js,requires-body=true

[MITM]
hostname = %APPEND% api.m.jd.com
