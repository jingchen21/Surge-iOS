#!name=JD - Comprehensive Ad and Page Cleanup
#!desc=Filters startup and splash advertising, homepage promotions and order/profile banners.
#!category=Ad Remove
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
#!tag=Ad Blocking

[Rule]
DOMAIN,perf.m.jd.com,REJECT
DOMAIN,mars.jd.com,REJECT
DOMAIN,mllog.jd.com,REJECT
DOMAIN,dsp-x.jd.com,REJECT
DOMAIN,xlog.jd.com,REJECT
DOMAIN,dgstatic.jd.com,REJECT
DOMAIN,sdkfp.jd.com,REJECT
DOMAIN,discover.300hu.com,REJECT
DOMAIN-SUFFIX,jzt.jd.com,REJECT
DOMAIN-SUFFIX,cm.jd.com,REJECT

[Map Local]
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:queryMaterialAdverts|jdaPreDownload)(?:&|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:bdsp-x|dsp-x)\.jd\.com\/adx\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
JD-Page-Cleanup = type=http-response,pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:deliverLayer|getSplash|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|startup|welcomeHome|readCustomSurfaceList)(?:&|$),script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/JD.js,requires-body=true,max-size=2097152,timeout=30

[MITM]
hostname = %APPEND% api.m.jd.com, bdsp-x.jd.com, dsp-x.jd.com
