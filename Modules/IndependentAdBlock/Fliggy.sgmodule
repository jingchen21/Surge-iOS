#!name=Fliggy - Ad Filter
#!desc=Filters advertising placements while keeping travel bookings and orders.
#!category=Ad Remove
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31

[Rule]
DOMAIN,ad-track.fliggy.com,REJECT

[Script]
Fliggy-Marketing = type=http-response, pattern=^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|predict)(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Fliggy.js, requires-body=true, timeout=30
Fliggy-Home = type=http-response, pattern=^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.ssif\.pattern\.home(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Fliggy.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% acs.m.taobao.com
