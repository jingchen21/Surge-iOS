#!name=飞猪｜独立去广告（保守版）
#!desc=营销资源和首页显式广告，保留机票酒店及预订订单
#!author=个人自用整理（AI 辅助），原作者见说明
#!category=去广告
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
# 仅技术参考：zirawell, fmz200, QingRex；全新独立代码，不复制第三方脚本。
# 请遵守原项目许可；未经实机验证，不与其他同类模块同时启用。

[Rule]
DOMAIN,ad-track.fliggy.com,REJECT

[Script]
飞猪-营销资源 = type=http-response, pattern=^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|predict)(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Fliggy.js, requires-body=true, timeout=30
飞猪-首页广告 = type=http-response, pattern=^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.ssif\.pattern\.home(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Fliggy.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% acs.m.taobao.com
