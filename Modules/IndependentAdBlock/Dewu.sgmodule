#!name=得物｜独立去广告（保守版）
#!desc=广告接口中的已知广告结构，保留优惠券、商品和交易
#!author=个人自用整理（AI 辅助），原作者见说明
#!category=去广告
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31
# 仅技术参考：zirawell, fmz200, QingRex；全新独立代码，不复制第三方脚本。
# 请遵守原项目许可；未经实机验证，不与其他同类模块同时启用。

[Script]
得物-广告接口 = type=http-response, pattern=^https:\/\/app\.dewu\.com\/api\/v\d+\/app\/advertisement(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Dewu.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% app.dewu.com
