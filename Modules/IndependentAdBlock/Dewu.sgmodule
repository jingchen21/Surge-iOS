#!name=Dewu - Ad Filter
#!desc=Filters known advertisement fields while retaining coupons, products, and checkout.
#!category=Ad Remove
#!basedOn=iOS
#!homepage=https://github.com/jingchen21/Surge-iOS
#!date=2026-10-31

[Script]
Dewu-Ad-Response = type=http-response, pattern=^https:\/\/app\.dewu\.com\/api\/v\d+\/app\/advertisement(?:\/|\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Dewu.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% app.dewu.com
