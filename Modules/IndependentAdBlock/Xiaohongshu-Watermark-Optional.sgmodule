# 仅技术参考：zirawell, fmz200；全新独立代码，不复制第三方脚本。
# 请遵守原项目许可；未经实机验证，不与其他同类模块同时启用。

[Script]
XHS-图片水印开关 = type=http-response, pattern=^https:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/(?:imagefeed|feed|videofeed)(?:\?|$), script-path=https://raw.githubusercontent.com/jingchen21/Surge-iOS/main/Modules/Scripts/IndependentAdBlock/Xiaohongshu-Watermark-Optional.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, rec.xiaohongshu.com, www.xiaohongshu.com
