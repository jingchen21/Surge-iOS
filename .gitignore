# Default deny: only the explicitly public tree is eligible for new commits.
*
!/.gitignore
!/README.md
!/LICENSE.md
!/THIRD_PARTY_NOTICES.md
!/Profiles/
!/Profiles/Surge-iPhone.conf
!/Modules/
!/Modules/README.md
!/Modules/Google-CN-Redirect.sgmodule
!/Modules/RoaycL/
!/Modules/RoaycL/*.sgmodule
!/Modules/RoaycL/README.md
!/JS/
!/JS/Txvideoad.surge.js
!/JS/hlwxx_remove_ads.surge.js
!/JS/Weibo.surge.js
!/JS/README.md
!/Rules/
!/Rules/README.md
!/Rules/Business-DIRECT.list
!/Rules/Apple-AI.list
!/scripts/
!/scripts/*.py
!/docs/
!/docs/*.md
!/upstreams/
!/upstreams/references.json
!/upstreams/roaycl-2026-10-27.json
!/LICENSES/
!/LICENSES/MIT-tools.txt
!/LICENSES/GPL-3.0-fmz200.txt
!/LICENSES/CC-BY-NC-SA-4.0-luestr.txt
!/.githooks/
!/.githooks/pre-commit
!/.github/
!/.github/workflows/
!/.github/workflows/public-check.yml

# Explicitly reject private material even inside allowed folders.
**/private/
**/secrets/
**/overlay.json
**/*.local.conf
**/*.p12
**/*.pfx
**/*.key
**/*.har
**/*.pcap
**/.env*
**/__pycache__/
**/*.pyc
**/.DS_Store
